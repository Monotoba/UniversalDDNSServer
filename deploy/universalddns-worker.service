[Unit]
Description=UniversalDDNSServer publishing worker (pre-alpha)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=universalddns
Group=universalddns
WorkingDirectory=/var/lib/universalddns
ExecStart=/opt/universalddns/venv/bin/python -m universalddns.runtime --config /etc/universalddns/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/universalddns
UMask=0077
[Install]
WantedBy=multi-user.target
