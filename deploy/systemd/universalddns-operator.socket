# Experimental opt-in local operator health check; NOT installed by default.
[Unit]
Description=UniversalDDNSServer experimental operator socket

[Socket]
ListenStream=/run/universalddns/operator.sock
SocketUser=universalddns
SocketGroup=universalddns-operators
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=operator
Service=universalddns-operator.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
